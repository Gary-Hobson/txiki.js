+static inline int js_op_define_global(JSContext *ctx, JSValue **psp, JSAtom atom,
+                                       unsigned flags, unsigned opcode)
+{
+    switch (opcode) {
+    case OP_check_define_var:
+        return JS_CheckDefineGlobalVar(ctx, atom, flags);
+    case OP_define_var:
+        return JS_DefineGlobalVar(ctx, atom, flags);
+    case OP_define_func:
+        if (JS_DefineGlobalFunction(ctx, atom, (*psp)[-1], flags))
+            return -1;
+        JS_FreeValue(ctx, (*psp)[-1]);
+        (*psp)--;
+        return 0;
+    default:
+        abort();
+    }
+}
