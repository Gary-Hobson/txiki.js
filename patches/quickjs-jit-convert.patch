+static inline int js_op_check_ctor(JSContext *ctx, JSValueConst new_target)
+{
+    if (JS_IsUndefined(new_target)) {
+        JS_ThrowTypeError(ctx, "class constructors must be invoked with 'new'");
+        return -1;
+    }
+    return 0;
+}
+
+static inline int js_op_check_ctor_return(JSContext *caller_ctx, JSValue *sp)
+{
+    bool use_this = !JS_IsObject(sp[-1]);
+    if (use_this && !JS_IsUndefined(sp[-1])) {
+        JS_ThrowTypeError(caller_ctx, "derived class constructor must return an object or undefined");
+        return -1;
+    }
+    sp[0] = js_bool(use_this);
+    return 0;
+}
+
+static JSValue js_op_init_ctor(JSContext *ctx, JSValueConst func_obj, JSValueConst new_target,
+                               int argc, JSValueConst *argv)
+{
+    if (js_op_check_ctor(ctx, new_target))
+        return JS_EXCEPTION;
+    JSValue super = JS_GetPrototype(ctx, func_obj);
+    if (JS_IsException(super))
+        return JS_EXCEPTION;
+    JSValue ret = JS_CallConstructor2(ctx, super, new_target, argc, argv);
+    JS_FreeValue(ctx, super);
+    return ret;
+}
+
+static JSValue js_op_special_object(JSContext *ctx, JSStackFrame *sf, const JSFunctionBytecode *b,
+                                    unsigned operand, JSValueConst new_target, int argc, JSValueConst *argv)
+{
+    switch (operand) {
+    case OP_SPECIAL_OBJECT_ARGUMENTS:
+        return js_build_arguments(ctx, argc, argv);
+    case OP_SPECIAL_OBJECT_MAPPED_ARGUMENTS:
+        return js_build_mapped_arguments(ctx, argc, argv, sf, min_int(argc, b->arg_count));
+    case OP_SPECIAL_OBJECT_THIS_FUNC:
+        return js_dup(sf->cur_func);
+    case OP_SPECIAL_OBJECT_NEW_TARGET:
+        return js_dup(new_target);
+    case OP_SPECIAL_OBJECT_HOME_OBJECT: {
+        JSObject *home = JS_VALUE_GET_OBJ(sf->cur_func)->u.func.home_object;
+        return home ? js_dup(JS_MKPTR(JS_TAG_OBJECT, home)) : JS_UNDEFINED;
+    }
+    case OP_SPECIAL_OBJECT_VAR_OBJECT:
+        return JS_NewObjectProto(ctx, JS_NULL);
+    case OP_SPECIAL_OBJECT_IMPORT_META:
+        return js_import_meta(ctx);
+    case OP_SPECIAL_OBJECT_NULL_PROTO:
+        return JS_NewObjectProtoClass(ctx, JS_NULL, JS_CLASS_OBJECT);
+    default:
+        abort();
+    }
+}
