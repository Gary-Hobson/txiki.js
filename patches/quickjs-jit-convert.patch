+static JSValue js_op_get_ref_value(JSContext *ctx, JSValue *sp)
+{
+    if (unlikely(JS_IsUndefined(sp[-2])))
+        return js_op_missing_reference(ctx, sp[-1]);
+    return JS_GetPropertyValue(ctx, sp[-2], js_dup(sp[-1]));
