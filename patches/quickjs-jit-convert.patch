+static inline int js_op_convert(JSContext *ctx, JSStackFrame *sf, uint8_t *pc,
+                                JSValue *sp, unsigned opcode)
+{
+    bool object = opcode == OP_to_object;
+    if (object) {
+        if (JS_IsObject(sp[-1]))
+            return 0;
+    } else {
+        /* A nullish receiver fails before any user key conversion. */
+        if (opcode == OP_to_propkey2 && unlikely(JS_IsUndefined(sp[-2]) || JS_IsNull(sp[-2]))) {
+            JS_ThrowTypeError(ctx, "value has no property");
+            return -1;
+        }
+        switch (JS_VALUE_GET_TAG(sp[-1])) {
+        case JS_TAG_INT: case JS_TAG_STRING: case JS_TAG_SYMBOL:
+            return 0;
+        }
+    }
+    sf->cur_pc = pc;
+    JSValue val = object ? JS_ToObject(ctx, sp[-1]) : JS_ToPropertyKey(ctx, sp[-1]);
+    if (JS_IsException(val))
+        return -1;
+    JS_FreeValue(ctx, sp[-1]);
+    sp[-1] = val;
+    return 0;
+}
