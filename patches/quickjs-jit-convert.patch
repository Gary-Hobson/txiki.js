+static int js_op_put_ref_value(JSContext *ctx, JSValue **psp)
+{
+    JSValue *sp = *psp;
+    int flags = JS_PROP_THROW_STRICT;
+    bool strict = is_strict_mode(ctx);
+    if (unlikely(JS_IsUndefined(sp[-3]))) {
