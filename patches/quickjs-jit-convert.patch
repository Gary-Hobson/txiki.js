+static inline JSValue js_op_rest(JSContext *ctx, int argc, JSValueConst *argv, unsigned first)
+{
+    int offset = min_int(first, argc);
+    int count = argc - offset;
+    return js_create_array(ctx, count, count ? &argv[offset] : NULL);
+}
