+/* A slot hint is safe across shape mutation and address reuse because
+   its bounds and atom are checked against the object's current shape.
+   Descriptor flags are deliberately left to the caller's existing checks. */
+static inline JSShapeProperty *find_own_property_hint(JSRuntime *rt,
+                                                      JSProperty **ppr,
+                                                      JSObject *p, JSAtom atom)
+{
+    JSShape *sh = p->shape;
+    JSShapeProperty *prs;
+    uint32_t *hint = &rt->own_property_slot_hints[atom & 1023];
+    uint32_t h = *hint;
+
+    if (h && h <= (uint32_t)sh->prop_count) {
+        prs = &get_shape_prop(sh)[h - 1];
+        if (prs->atom == atom) {
+            *ppr = &p->prop[h - 1];
+            return prs;
+        }
+    }
+
+    prs = find_own_property(ppr, p, atom);
+    if (prs)
+        *hint = (uint32_t)(*ppr - p->prop) + 1;
+    return prs;
+}
+
+/* Borrow the local receiver while executing an adjacent plain own-field
+   load. No allocation or JavaScript reentry occurs on this fused path. */
+static inline JSValue js_load_local_or_field(JSValueConst value,
+                                             uint8_t **ppc)
+{
+    uint8_t *pc = *ppc;
+    JSProperty *pr;
+    JSShapeProperty *prs;
+#ifdef ENABLE_DUMPS
+    return js_dup(value);
+#endif
+    if (*pc == OP_get_field && JS_VALUE_GET_TAG(value) == JS_TAG_OBJECT) {
+        prs = find_own_property(&pr, JS_VALUE_GET_OBJ(value), get_u32(pc + 1));
+        if (prs && !(prs->flags & JS_PROP_TMASK)) {
+            *ppc = pc + 5;
+            return js_dup(pr->u.value);
+        }
+    }
+    return js_dup(value);
+}
