+
+static JSStackFrame *js_get_stack_frame_at_level(JSContext *ctx, int level)
+{
+    JSRuntime *rt = ctx->rt;
+    JSStackFrame *sf = rt->current_stack_frame;
+    int current_level = 0;
+
+    while (sf != NULL && current_level < level) {
+        sf = sf->prev_frame;
+        current_level++;
+    }
+    return sf;
+}
+
+int JS_GetStackDepth(JSContext *ctx)
+{
+    JSRuntime *rt = ctx->rt;
+    JSStackFrame *sf = rt->current_stack_frame;
+    int depth = 0;
+
+    while (sf != NULL) {
+        depth++;
+        sf = sf->prev_frame;
+    }
+    return depth;
+}
