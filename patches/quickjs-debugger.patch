+static void emit_debug_opcode(JSParseState *s, uint8_t opcode)
+{
+    JSFunctionDef *fd = s->cur_func;
+    dbuf_putc(&fd->byte_code, opcode);
+    dbuf_put_u16(&fd->byte_code, fd->scope_level);
+    /* Use direct eval's capture rules so all bindings are inspectable,
+       including enclosing variables not otherwise used by the function. */
+    fd->has_eval_call = true;
+}
