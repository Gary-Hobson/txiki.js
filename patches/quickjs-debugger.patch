+bool JS_GetDebugFrame(JSContext *ctx, int level, JSAtom *filename,
+                      JSAtom *function, int *line, int *column)
+{
+    JSStackFrame *sf = js_get_stack_frame_at_level(ctx, level);
+    if (!sf || !JS_IsObject(sf->cur_func))
+        return false;
+    JSObject *p = JS_VALUE_GET_OBJ(sf->cur_func);
+    if (!js_class_has_bytecode(p->class_id))
+        return false;
+    JSFunctionBytecode *b = p->u.func.function_bytecode;
+    *filename = b->filename;
+    *function = b->func_name;
+    *column = 1;
+    *line = sf->cur_pc ? find_line_num(ctx, b, sf->cur_pc - b->byte_code_buf - 1, column) : 1;
+    return true;
+}
