+void JS_ForEachDebugLocation(JSContext *ctx, JSValueConst bytecode,
+                              JSDebugLocationFunc *callback, void *opaque)
+{
+    if (JS_VALUE_GET_TAG(bytecode) != JS_TAG_FUNCTION_BYTECODE)
+        return;
+    JSFunctionBytecode *b = JS_VALUE_GET_PTR(bytecode);
+    for (int pc = 0; pc < b->byte_code_len;) {
+        int op = b->byte_code_buf[pc];
+        if (op == OP_debug || op == OP_debugger_stmt) {
+            int column = 0;
+            int line = find_line_num(ctx, b, pc, &column);
+            if (line > 0)
+                callback(line, column, opaque);
+        }
+        pc += short_opcode_info(op).size;
+    }
+    for (int i = 0; i < b->cpool_count; i++)
+        JS_ForEachDebugLocation(ctx, b->cpool[i], callback, opaque);
+}
