+static inline JSValue *js_stack_insert(JSValue *sp, unsigned depth)
+{
+    JSValue value = sp[-1];
+    memmove(sp - depth + 1, sp - depth, (depth - 1) * sizeof(*sp));
+    sp[0] = value;
+    *(sp - depth) = js_dup(value);
+    return sp + 1;
+}
