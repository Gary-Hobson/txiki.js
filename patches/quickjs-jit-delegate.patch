+/* The iterator record and its argument remain in the caller's rooted frame. */
+static __exception int js_op_iterator_next(JSContext *ctx, JSValue *sp)
+{
+    JSValue ret = JS_Call(ctx, sp[-3], sp[-4], 1, vc(sp - 1));
+    if (JS_IsException(ret))
+        return -1;
+    JS_FreeValue(ctx, sp[-1]);
+    sp[-1] = ret;
+    return 0;
+}
+
+static __exception int js_op_iterator_call(JSContext *ctx, JSValue *sp, unsigned flags)
+{
+    JSAtom atom = (flags & 1) ? JS_ATOM_throw : JS_ATOM_return;
+    JSValue method = JS_GetProperty(ctx, sp[-4], atom);
+    if (JS_IsException(method))
+        return -1;
+    bool absent = JS_IsUndefined(method) || JS_IsNull(method);
+    if (!absent) {
+        bool no_argument = flags & 2;
+        JSValue ret = JS_CallFree(ctx, method, sp[-4], !no_argument,
+                                 no_argument ? NULL : vc(sp - 1));
+        if (JS_IsException(ret))
+            return -1;
+        JS_FreeValue(ctx, sp[-1]);
+        sp[-1] = ret;
+    }
+    sp[0] = js_bool(absent);
+    return 0;
+}
