+/* Pop the catch marker before invoking return(), so a throw cannot close
+   the iterator again. Keep the iterator owned by the stack until success. */
+static __exception int js_iterator_close_stack(JSContext *ctx, JSValue **psp)
+{
+    JSValue *sp = *psp - 2;
+    *psp = sp;
+    JS_FreeValue(ctx, sp[0]);
+    if (!JS_IsUndefined(sp[-1])) {
+        if (JS_IteratorClose(ctx, sp[-1], false))
+            return -1;
+        JS_FreeValue(ctx, sp[-1]);
+    }
+    *psp = sp - 1;
+    return 0;
+}
