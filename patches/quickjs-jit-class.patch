+static inline int js_op_super(JSContext *ctx, JSValue **psp, unsigned opcode)
+{
+    JSValue *sp = *psp;
+    switch (opcode) {
+    case OP_get_super: {
+        JSValue proto = JS_GetPrototype(ctx, sp[-1]);
+        if (JS_IsException(proto))
+            return -1;
+        JS_FreeValue(ctx, sp[-1]);
+        sp[-1] = proto;
+        return 0;
+    }
+    case OP_get_super_value: {
+        JSAtom atom = JS_ValueToAtom(ctx, sp[-1]);
+        if (unlikely(atom == JS_ATOM_NULL))
+            return -1;
+        JSValue value = JS_GetPropertyInternal(ctx, sp[-2], atom, sp[-3], false);
+        JS_FreeAtom(ctx, atom);
+        if (unlikely(JS_IsException(value)))
+            return -1;
+        JS_FreeValue(ctx, sp[-1]);
+        JS_FreeValue(ctx, sp[-2]);
+        JS_FreeValue(ctx, sp[-3]);
+        sp[-3] = value;
+        *psp = sp - 2;
+        return 0;
+    }
+    case OP_put_super_value: {
+        if (!JS_IsObject(sp[-3])) {
+            JS_ThrowTypeErrorNotAnObject(ctx);
+            return -1;
+        }
+        JSAtom atom = JS_ValueToAtom(ctx, sp[-2]);
+        if (unlikely(atom == JS_ATOM_NULL))
+            return -1;
+        int ret = JS_SetPropertyInternal2(ctx, sp[-3], atom, sp[-1], sp[-4], JS_PROP_THROW_STRICT);
+        JS_FreeAtom(ctx, atom);
+        JS_FreeValue(ctx, sp[-4]);
+        JS_FreeValue(ctx, sp[-3]);
+        JS_FreeValue(ctx, sp[-2]);
+        *psp = sp - 4;
+        return ret < 0 ? -1 : 0;
+    }
+    default:
+        abort();
+    }
+}
+
+static inline int js_op_private(JSContext *ctx, JSValue **psp, unsigned opcode)
+{
+    JSValue *sp = *psp;
+    switch (opcode) {
+    case OP_check_brand: {
+        int ret = JS_CheckBrand(ctx, sp[-2], sp[-1]);
+        if (ret < 0)
+            return -1;
+        if (!ret) {
+            JS_ThrowTypeError(ctx, "invalid brand on object");
+            return -1;
+        }
+        return 0;
+    }
+    case OP_add_brand:
+        if (JS_AddBrand(ctx, sp[-2], sp[-1]) < 0)
+            return -1;
+        JS_FreeValue(ctx, sp[-2]);
+        JS_FreeValue(ctx, sp[-1]);
+        *psp = sp - 2;
+        return 0;
+    case OP_get_private_field: {
+        JSValue value = JS_GetPrivateField(ctx, sp[-2], sp[-1]);
+        JS_FreeValue(ctx, sp[-1]);
+        JS_FreeValue(ctx, sp[-2]);
+        sp[-2] = value;
+        *psp = sp - 1;
+        return JS_IsException(value) ? -1 : 0;
+    }
+    case OP_put_private_field: {
+        int ret = JS_SetPrivateField(ctx, sp[-3], sp[-1], sp[-2]);
+        JS_FreeValue(ctx, sp[-3]);
+        JS_FreeValue(ctx, sp[-1]);
+        *psp = sp - 3;
+        return ret < 0 ? -1 : 0;
+    }
+    case OP_define_private_field: {
+        int ret = JS_DefinePrivateField(ctx, sp[-3], sp[-2], sp[-1]);
+        JS_FreeValue(ctx, sp[-2]);
+        *psp = sp - 2;
+        return ret < 0 ? -1 : 0;
+    }
+    default:
+        abort();
+    }
+}
