+/* The input stack remains owned by the caller until the operation succeeds. */
+static inline int js_op_apply_or_eval(JSContext *ctx, JSValue **psp, unsigned opcode,
+                                      const uint8_t *operands)
+{
+    unsigned first = get_u16(operands);
+    JSValue *sp = *psp;
+    JSValue *base;
+    JSValue ret;
+
+    switch (opcode) {
+    case OP_apply:
+        base = sp - 3;
+        ret = js_function_apply(ctx, base[0], 2, vc(base + 1), first);
+        break;
+    case OP_eval: {
+        base = sp - first - 1;
+        if (js_same_value(ctx, base[0], ctx->eval_obj)) {
+            int scope_idx = get_u16(operands + 2) - 1;
+            ret = JS_EvalObject(ctx, JS_UNDEFINED, first ? base[1] : JS_UNDEFINED,
+                                JS_EVAL_TYPE_DIRECT, scope_idx);
+        } else {
+            ret = JS_CallInternal(ctx, base[0], JS_UNDEFINED, JS_UNDEFINED,
+                                  first, vc(base + 1), 0);
+        }
+        break;
+    }
+    case OP_apply_eval: {
+        uint32_t len;
+        base = sp - 2;
+        JSValue *tab = build_arg_list(ctx, &len, base[1]);
+        if (!tab)
+            return -1;
+        if (js_same_value(ctx, base[0], ctx->eval_obj)) {
+            int scope_idx = (int)first - 1;
+            ret = JS_EvalObject(ctx, JS_UNDEFINED, len ? tab[0] : JS_UNDEFINED,
+                                JS_EVAL_TYPE_DIRECT, scope_idx);
+        } else {
+            ret = JS_Call(ctx, base[0], JS_UNDEFINED, len, vc(tab));
+        }
+        free_arg_list(ctx, tab, len);
+        break;
+    }
+    default:
+        abort();
+    }
+    if (unlikely(JS_IsException(ret)))
+        return -1;
+    for (JSValue *slot = base; slot < sp; slot++)
+        JS_FreeValue(ctx, *slot);
+    *base = ret;
+    *psp = base + 1;
+    return 0;
+}
